{
  "appId": "com.yourname.wallet",
  "appName": "Wallet",
  "webDir": "dist",
  "ios": {
    "contentInset": "automatic",
    "backgroundColor": "#f0f0f0"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 1200,
      "backgroundColor": "#f0f0f0",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "Default"
    }
  }
}
